{
  "name": "temporal-workflow-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Temporal workflow engine for browser, script, HTTP, and approval steps",
  "scripts": {
    "dev": "pnpm --filter @temporal-workflow-engine/* run dev",
    "build": "pnpm --filter @temporal-workflow-engine/* run build",
    "start:api": "pnpm --filter @temporal-workflow-engine/api run start:dev",
    "start:worker": "pnpm --filter @temporal-workflow-engine/worker run start:dev",
    "start:designer": "pnpm --filter @temporal-workflow-engine/designer run dev",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "temporal:dev-server": "node scripts/temporal-dev-server.mjs"
  },
  "keywords": [
    "temporal",
    "workflow",
    "playwright",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
